{
  "name": "@sightline/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "reference": "tsx src/reference.ts",
    "run": "tsx src/cli.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
